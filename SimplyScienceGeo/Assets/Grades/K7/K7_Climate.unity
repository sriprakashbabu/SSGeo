  m_Name: 
  m_EditorClassIdentifier: 
  featureName: Summer Winds
  informationText: '<align=left><b>Key Effect:</b> Winds carry moisture and temperature,
    affecting rainfall and weather.

    <b>Examples:</b> States like Punjab, Haryana,
    Rajasthan and Madhya Pradesh often

    receive winds blowing over the deserts
    of Arabia to Afghanistan, they bring dry

    and hot air that causes severe
    heat waves in summer.'
  highlightColor: {r: 1, g: 0.92156863, b: 0.015686275, a: 1}
  overrideInitialColor: 0
  initialColor: {r: 1, g: 1, b: 1, a: 1}
