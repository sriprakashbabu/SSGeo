  m_EditorClassIdentifier: 
  featureName: Mesosphere
  informationText: "<align=left><b>Height Range:</b> 50 \u2013 80 km\r\n<b>Key Features:</b>
    Meteors burn up due to atmospheric friction.\r\n<b>Temperature Trend:</b> Decreases
    with altitude (around -90\xB0C)\r\n\r<b>Elements:</b> Meteors, gravity waves,
    thin air molecules"
  highlightColor: {r: 0.64779866, g: 0.64779866, b: 0.64779866, a: 0.5019608}
  overrideInitialColor: 1
