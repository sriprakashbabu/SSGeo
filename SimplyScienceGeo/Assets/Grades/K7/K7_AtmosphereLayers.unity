  m_Script: {fileID: 11500000, guid: ecae9b93724bbb34da7a93263d8c22e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  featureName: Exosphere
  informationText: "<align=left><b>Height Range:</b> 700 \u2013 10,000 km, merging
    into space\r\n<b>Key Features: </b>Very thin air with traces of hydrogen and
    helium; transition to outer space.\r\n<b>Temperature Trend: </b>Increases with
    altitude (undefined maximum)\r\n<b>Elements:</b> High-altitude satellites, hydrogen
    and helium atoms"
  highlightColor: {r: 0.64779866, g: 0.64779866, b: 0.64779866, a: 0.5019608}
  overrideInitialColor: 1
  initialColor: {r: 0.5764706, g: 0.4392157, b: 0.85882354, a: 0.29803923}
