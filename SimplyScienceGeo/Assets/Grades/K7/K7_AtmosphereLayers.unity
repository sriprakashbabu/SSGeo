--- !u!114 &6162090539909915916
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3489625221785893330}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ecae9b93724bbb34da7a93263d8c22e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  featureName: Stratosphere
  informationText: "<align=left><b>Height Range:</b> 12 \u2013 50 km\n<b>Key Features:</b>
    Contains the ozone layer that absorbs harmful UV radiation. The warming in this
    layer occurs due to the ozone layer absorbing ultraviolet (UV) radiation from
    the Sun and releasing heat.\n<b>Temperature Trend:</b> At the lower boundary
    (around 12 km), the temperature is approximately \u201356\xB0C. At the upper
    boundary (around 50 km, the stratopause), the temperature rises to about 0\xB0C
    to \u20132\xB0C.\n<b>Elements:</b> Ozone layer visuals, research balloons, supersonic
    jets"
  highlightColor: {r: 0.64779866, g: 0.64779866, b: 0.64779866, a: 0.5019608}
  overrideInitialColor: 1
  initialColor: {r: 1, g: 0.84313726, b: 0, a: 0.29803923}
