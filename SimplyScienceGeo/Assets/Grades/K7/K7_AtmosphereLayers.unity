  m_Name: 
  m_EditorClassIdentifier: 
  featureName: Thermosphere
  informationText: "<align=left><b>Height Range:</b> 80 \u2013 700 km\r\n<b>Key Features:</b>
    Contains the ionosphere; auroras occur here; absorbs high-energy solar radiation
    causing temperature spikes.\r\n<b>Temperature Trend:</b> Increases with altitude
    (up to 1500\xB0C)\r\n<b>Elements:</b> Auroras, satellites, space debris, spacecraft"
  highlightColor: {r: 0.64779866, g: 0.64779866, b: 0.64779866, a: 0.5019608}
  overrideInitialColor: 1
