  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Volcanic islands of the Bay of Bengal; dense tropical forests, rich biodiversity,
    and strategic importance. This island is divided into two groups: Andaman (north)
    and Nicobar (south) with a visible small water gap between them. It is believed
    to be elevated portions of submerged mountains. It holds strategic importance
    for India\u2019s defense and trade. Andaman & Nicobar experiences equatorial
    climate with dense forests and diverse flora and fauna characterised by thick
    tree canopy.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
