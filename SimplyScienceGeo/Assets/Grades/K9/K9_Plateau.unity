--- !u!114 &1360809657
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1360809655}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 32497a2b8770d294aba01e6c401f7d81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dropdown: {fileID: 1360809658}
  interactionManager: {fileID: 0}
  uiManager: {fileID: 0}
  globeRotator: {fileID: 0}
  optionGroups:
  - groupName: Lattitude
    toggleGroupParent: {fileID: 0}
    additionalObjectsToActivate:
    - {fileID: 0}
    objectsToDeactivate: []
    defaultToggle: {fileID: 0}
    titleText: Latitude
    bodyText: Latitude lines measure distance north or south of the Earth's equator.
    targetRotation: {x: 0, y: 145, z: 0}
    targetZoom: 26.82
  - groupName: Altitude
    toggleGroupParent: {fileID: 0}
    additionalObjectsToActivate:
    - {fileID: 0}
    objectsToDeactivate: []
    defaultToggle: {fileID: 0}
    titleText: Altitude
    bodyText: "<align=left><b>Key Effect:</b> Temperature decreases with increase
      in height. There is a fall in temperature by 6.5\xB0C per kilometer of altitude
      gain.\r\n<b>Examples:</b> Quito cooler than coastal Guayaquil, Leh colder than
      Delhi.\n<b>(Click on Himalayas for the 3D model about altitude)"
    targetRotation: {x: 3.8, y: -103.2, z: 32}
    targetZoom: 16
  - groupName: Proximity to Sea
    toggleGroupParent: {fileID: 0}
    additionalObjectsToActivate: []
    objectsToDeactivate: []
    defaultToggle: {fileID: 0}
    titleText: Proximity to sea.
    bodyText: <align=left>Choose whether the wind blows from land to sea or sea to
      land to explore how coastal areas stay cooler or warmer through the day and
      night.
    targetRotation: {x: 9, y: -113, z: 24}
    targetZoom: 13
  - groupName: Winds
    toggleGroupParent: {fileID: 0}
    additionalObjectsToActivate: []
    objectsToDeactivate: []
    defaultToggle: {fileID: 0}
    titleText: Winds
    bodyText: <align=left>Select a wind type to see how it changes the temperature
      and weather conditions.
    targetRotation: {x: 11, y: -110, z: 30}
    targetZoom: 15
  - groupName: Topography
    toggleGroupParent: {fileID: 0}
    additionalObjectsToActivate:
    - {fileID: 0}
    objectsToDeactivate: []
    defaultToggle: {fileID: 0}
    titleText: Topography
    bodyText: '<align=left><b>Key Effect:</b> Landforms like mountains block winds
      and create rain-shadow zones.

      <b>Examples:</b> Western Ghats (heavy
      rainfall on coastal side, dry Deccan Plateau), Himalayas block cold winds from
      Central Asia.

      <b>(Click on Western Ghats for the 3D model)'
    targetRotation: {x: 8, y: -106.8, z: 20.4}
    targetZoom: 13
