  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <b>Mysuru\u2013Bengaluru</b> (Karnataka \u2013 South India) is
    the largest mulberry silk-producing region in India.\n\u2022 <b>Murshidabad</b>
    (West Bengal \u2013 East India) is an important centre for silk weaving and sericulture.\n\u2022
    <b>Assam</b> (North-East India) is known for exclusive muga and eri silk varieties.\n\u2022
    The <b>first silk mill of India</b> was located in <b>Basavanagudi, Bengaluru</b>
    (Karnataka) in <b>1888</b>, known as the <i>Silk Filature Unit (Government Silk
    Factory)</i>.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
