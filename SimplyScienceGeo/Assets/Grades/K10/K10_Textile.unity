  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <b>Ludhiana</b> (Punjab \u2013 North India) is India\u2019s largest
    woollen knitwear and hosiery centre.\n\u2022 <b>Srinagar</b> (Jammu & Kashmir
    \u2013 Northern Himalayas) is famous for pashmina shawls and fine wool products.\n\u2022
    <b>Bikaner</b> (Rajasthan \u2013 North-West India) is a major centre for carpet-grade
    wool and wool processing.\n\u2022 The <b>first woollen mill of India</b> was
    located in <b>Kanpur</b> (Uttar Pradesh) in <b>1870</b>, known as the <i>Lal
    Imli Woollen Mill</i>.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
