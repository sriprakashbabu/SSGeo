  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <b>Mumbai\u2013Pune Region</b> (Maharashtra \u2013 Western India)
    is the oldest cotton textile belt with large mills and processing units.\n\u2022
    <b>Ahmedabad</b> (Gujarat \u2013 Western India) is known as the <i>\u201CManchester
    of India\u201D</i> due to its dense cotton industry.\n\u2022 <b>Coimbatore\u2013Tiruppur
    Region</b> (Tamil Nadu \u2013 Southern India) is a major hub for spinning, weaving,
    and knitwear exports.\n\u2022 The <b>first cotton mill of India</b> was located
    in <b>Mumbai (Bombay)</b> in <b>1854</b>, known as the <i>Bombay Spinning and
    Weaving Mill</i>.\n"
