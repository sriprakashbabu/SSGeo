  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Bhilai (Chhattisgarh) is one of India\u2019s largest steel plants; established
    with Soviet collaboration. The Rourkela (Odisha) plant is the first public sector
    integrated steel plant which was set up with German assistance. Bokaro (Jharkhand)
    is the high-capacity modern steel plant, located in coal-rich belt. The Durgapur
    & Burnpur Plant (West Bengal) has key units in the eastern steel belt."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
